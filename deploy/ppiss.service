[Unit]
Description=PPISS generative telemetry display
After=systemd-user-sessions.service

[Service]
Type=simple
User=ppiss
Group=ppiss
SupplementaryGroups=video render
WorkingDirectory=/opt/ppiss
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=dummy
ExecStart=/opt/ppiss/.venv/bin/ppiss-display --fps 30
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
