[Unit]
Description=PPISS generative telemetry display
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/ppiss
Environment=SDL_VIDEODRIVER=kmsdrm
ExecStart=/opt/ppiss/.venv/bin/ppiss-display --fps 30
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
